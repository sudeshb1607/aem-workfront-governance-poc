<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0"
          xmlns:jcr="http://www.jcp.org/jcr/1.0"
          xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Live Long-Published (No Children) Report"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <brands
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Brands"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <brands
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Brands"
                                fieldDescription="Each brand and its single content root. One CSV is produced per brand."
                                composite="{Boolean}true">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/container"
                                    name="./brands">
                                    <items jcr:primaryType="nt:unstructured">
                                        <brand
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                            fieldLabel="Brand"
                                            fieldDescription="e.g. natwest, rbs, ulster (used in the file/dataset name)."
                                            name="./brand"/>
                                        <rootPath
                                            jcr:primaryType="nt:unstructured"
                                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                            fieldLabel="Content Root"
                                            fieldDescription="The single site root under /content scanned for this brand."
                                            name="./rootPath">
                                            <datasource
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="mysite/datasource/report-brand-roots"/>
                                        </rootPath>
                                    </items>
                                </field>
                            </brands>
                        </items>
                    </brands>
                    <rule
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Rule"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                        <thresholdMonths
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                            fieldLabel="Last-published Threshold (months)"
                            fieldDescription="Include live pages last published more than this many months ago (no child page, no exclusion flag)."
                            name="./thresholdMonths"
                            min="{Long}0"
                            value="18"/>
                        </items>
                    </rule>
                    <exclusions
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Exclusions"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <excludePaths
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Exclude Paths"
                                fieldDescription="Path prefixes to exclude from the report.">
                                <field
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldLabel="Exclude Path"
                                    name="./excludePaths"
                                    rootPath="/content"/>
                            </excludePaths>
                            <excludePropertyName
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Exclusion Property (optional)"
                                fieldDescription="Property tested on jcr:content (then the page node). Leave empty for no property-based exclusion."
                                name="./excludePropertyName"/>
                            <excludePropertyValue
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Exclusion Value"
                                fieldDescription="Exclude the page when the property equals this value."
                                name="./excludePropertyValue">
                                <items jcr:primaryType="nt:unstructured">
                                    <optTrue
                                        jcr:primaryType="nt:unstructured"
                                        text="true"
                                        value="true"/>
                                    <optFalse
                                        jcr:primaryType="nt:unstructured"
                                        text="false"
                                        value="false"/>
                                </items>
                            </excludePropertyValue>
                        </items>
                    </exclusions>
                    <output
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Output"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <outputFolder
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="CSV Base Folder"
                                fieldDescription="CSVs are written to &lt;folder&gt;/csv/&lt;reportId&gt;-&lt;brand&gt;.csv."
                                name="./outputFolder"
                                rootPath="/content/dam"
                                value="/content/dam/mysite/workfront-reports/live-long-no-children"/>
                            <maxRecords
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Max Records per Brand"
                                fieldDescription="1–1000. Workfront reports are hard-capped at 1000 rows per brand."
                                name="./maxRecords"
                                min="{Long}1"
                                max="{Long}1000"
                                value="1000"/>
                            <activateCsv
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Activate CSV after generation"
                                name="./activateCsv"
                                value="true"
                                uncheckedValue="false"/>
                            <activateCsvDefault
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                name="./activateCsv@DefaultValue"
                                value="false"/>
                            <activateCsvUseDefault
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                name="./activateCsv@UseDefaultWhenMissing"
                                value="{Boolean}true"/>
                        </items>
                    </output>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
